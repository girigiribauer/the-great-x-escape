# --- Supabase ---
SUPABASE_URL=
# サーバー専用。RLSをバイパスするので絶対にクライアントへ露出させない
SUPABASE_SERVICE_ROLE_KEY=

# 本番: https://the-great-x-escape.vercel.app 等 / ローカル空欄でループバック扱い
PUBLIC_URL=

# --- X OAuth 2.0 ---
X_CLIENT_ID=
X_CLIENT_SECRET=

# --- Bluesky OAuth ---
# 本番の private_key_jwt 用の ES256 秘密鍵(JWK)。ローカル(ループバック)では不要=空欄。
# 生成: 下記コマンドの出力(単一行JSON)をそのまま貼る。
#   node --input-type=module -e "import {JoseKey} from '@atproto/jwk-jose'; const k=await JoseKey.generate(['ES256']); console.log(JSON.stringify(k.privateJwk))"
OAUTH_PRIVATE_KEY=

# ログインセッション Cookie の封緘キー。32文字以上のランダム文字列。
# 生成例: node -e "console.log(require('crypto').randomBytes(48).toString('base64url'))"
SESSION_SECRET=
